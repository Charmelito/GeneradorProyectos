<div class="code-editor">
    <textarea @bind="Content" @bind:event="oninput" rows="@Rows" placeholder="@Placeholder"></textarea>
</div>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContentChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 15;
    [Parameter] public string Placeholder { get; set; } = "Paste or type code...";
}

<style>
    .code-editor textarea { width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.8rem; line-height: 1.5; box-sizing: border-box; background: #1e1e2e; color: #cdd6f4; resize: vertical; }
    .code-editor textarea:focus { outline: none; border-color: #1a1a2e; }
</style>
