<div class="progress-container">
    @foreach (var step in Steps)
    {
        <div class="progress-step @(step.Status switch { "Completed" => "completed", "Failed" => "failed", "InProgress" => "in-progress", _ => "pending" })">
            <div class="step-indicator">
                @(step.Status == "Completed" ? "&#x2705;" :
                  step.Status == "Failed" ? "&#x274C;" :
                  step.Status == "InProgress" ? "&#x23F3;" :
                  "&#x26AA;")
            </div>
            <div class="step-info">
                <strong>@step.Name</strong>
                @if (step.Error != null)
                {
                    <span class="step-error">@step.Error</span>
                }
                @if (step.Metadata?.Any() == true)
                {
                    <span class="step-meta">
                        @string.Join(", ", step.Metadata.Select(m => $"{m.Key}={m.Value}"))
                    </span>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<StepInfo> Steps { get; set; } = new();
}

<style>
    .progress-container { display: flex; flex-direction: column; gap: 0.25rem; }
    .progress-step { display: flex; gap: 0.5rem; align-items: flex-start; padding: 0.5rem; border-radius: 8px; background: #f5f5f5; }
    .progress-step.completed { background: #e8f5e9; }
    .progress-step.failed { background: #fde8e8; }
    .progress-step.in-progress { background: #e3f2fd; }
    .step-indicator { font-size: 1.1rem; min-width: 24px; text-align: center; }
    .step-info strong { display: block; font-size: 0.85rem; }
    .step-error { color: #c0392b; font-size: 0.75rem; display: block; }
    .step-meta { color: #666; font-size: 0.7rem; display: block; }
</style>
