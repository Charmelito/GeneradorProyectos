@page "/differential"
@inject Services.ApiClient Api

<h2>Differential Review</h2>
<p class="sub">Review proposed changes before applying to project</p>

<div class="diff-layout">
    <div class="changes-panel">
        <h4>Changes</h4>
        <div class="summary-box">
            <span class="stat new">+@summary.NewFiles new</span>
            <span class="stat mod">~@summary.ModifiedFiles modified</span>
            <span class="stat conf">!@summary.ConflictFiles conflicts</span>
            <span class="stat unch">@summary.UnchangedFiles unchanged</span>
        </div>
        @foreach (var change in changes)
        {
            <div class="change-item @(change.IsConfirmed ? "confirmed" : "")"
                 @onclick="() => SelectChange(change)">
                <span class="change-icon">
                    @(change.Type == "New" ? "+" : change.Type == "Modified" ? "~" : change.Type == "Conflict" ? "!" : "=")
                </span>
                <span class="change-path">@change.RelativePath</span>
                @if (change.Conflicts?.Count > 0)
                {
                    <span class="conflict-badge">@change.Conflicts.Count conflicts</span>
                }
            </div>
        }
        <div class="button-row">
            <button class="btn btn-primary" @onclick="ConfirmAll">Accept All</button>
            <button class="btn btn-secondary" @onclick="ConfirmSelected">Accept Selected</button>
        </div>
    </div>
    <div class="diff-viewer">
        @if (selectedChange != null)
        {
            <h5>@selectedChange.RelativePath (@selectedChange.Type)</h5>
            <pre class="diff-content"><code>@selectedChange.Diff</code></pre>
        }
        else
        {
            <p class="placeholder">Select a file to view diff</p>
        }
    </div>
</div>

@code {
    private Models.DiffSummary summary = new();
    private List<Models.DiffChange> changes = new();
    private Models.DiffChange? selectedChange;

    public void LoadDiff(Models.DiffResult result)
    {
        summary = result.Summary ?? new();
        changes = result.Changes ?? new();
        StateHasChanged();
    }

    private void SelectChange(Models.DiffChange c)
    {
        c.IsConfirmed = !c.IsConfirmed;
        selectedChange = c;
    }

    private void ConfirmAll()
    {
        foreach (var c in changes) c.IsConfirmed = true;
    }

    private void ConfirmSelected() { }
}

<style>
    .sub { color: #666; margin-bottom: 1rem; }
    .diff-layout { display: grid; grid-template-columns: 320px 1fr; gap: 1rem; }
    .changes-panel, .diff-viewer { background: #fff; border-radius: 10px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .summary-box { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .stat { font-size: 0.75rem; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
    .stat.new { background: #d8f3dc; color: #2d6a4f; }
    .stat.mod { background: #fff3cd; color: #856404; }
    .stat.conf { background: #fde8e8; color: #c0392b; }
    .stat.unch { background: #e0e0e0; color: #666; }
    .change-item { padding: 0.35rem 0.5rem; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2px; }
    .change-item:hover { background: #f5f5f5; }
    .change-item.confirmed { background: #e8f5e9; }
    .change-icon { font-weight: 700; width: 18px; text-align: center; }
    .change-path { font-size: 0.8rem; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .conflict-badge { font-size: 0.65rem; background: #fee; color: #c0392b; padding: 1px 6px; border-radius: 10px; }
    .button-row { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
    .btn { padding: 0.4rem 0.75rem; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.8rem; }
    .btn-primary { background: #1a1a2e; color: #fff; }
    .btn-secondary { background: #e0e0e0; color: #333; }
    .diff-content { padding: 0.75rem; background: #f8f8f8; border-radius: 6px; font-size: 0.75rem; line-height: 1.5; white-space: pre-wrap; overflow-x: auto; }
    .diff-content { margin: 0; }
    .placeholder { color: #999; font-style: italic; text-align: center; padding: 3rem; }
</style>
