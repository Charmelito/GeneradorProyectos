@page "/prompts"
@inject Services.ApiClient Api

<h2>Prompt Manager</h2>
<p class="sub">Manage AI generation prompt templates</p>

<div class="prompt-layout">
    <div class="prompt-list">
        <h4>Templates</h4>
        <button class="btn btn-primary btn-sm" @onclick="CreateNew">+ New</button>
        @if (!prompts.Any())
        {
            <p class="placeholder">Loading...</p>
        }
        else
        {
            @foreach (var p in prompts)
            {
                <div class="prompt-item @(selectedPrompt?.Id == p.Id ? "selected" : "")"
                     @onclick="() => SelectPrompt(p)">
                    <strong>@p.Name</strong>
                    <span class="cat">@p.Category</span>
                    @if (p.IsSystem) { <span class="badge">system</span> }
                </div>
            }
        }
    </div>
    <div class="prompt-editor">
        @if (selectedPrompt != null)
        {
            <input class="name-input" @bind="selectedPrompt.Name" placeholder="Name" />
            <input class="cat-input" @bind="selectedPrompt.Category" placeholder="Category" />
            <textarea class="content-area" @bind="selectedPrompt.TemplateContent" rows="15"
                      placeholder="YAML prompt template..."></textarea>
            <div class="editor-actions">
                <button class="btn btn-primary" @onclick="SavePrompt">Save</button>
                <button class="btn btn-secondary" @onclick="() => DeletePrompt(selectedPrompt)" disabled="@selectedPrompt.IsSystem">Delete</button>
            </div>
        }
        else
        {
            <p class="placeholder">Select a prompt to edit</p>
        }
    </div>
</div>

@code {
    private List<Models.PromptDto> prompts = new();
    private Models.PromptDto? selectedPrompt;

    protected override async Task OnInitializedAsync()
    {
        prompts = await Api.GetPromptsAsync() ?? new();
    }

    private void SelectPrompt(Models.PromptDto p) => selectedPrompt = p;
    private void CreateNew() => selectedPrompt = new() { Id = Guid.NewGuid(), Name = "New Prompt", Category = "general" };

    private async Task SavePrompt()
    {
        if (selectedPrompt == null) return;
        await Api.SavePromptAsync(selectedPrompt);
        prompts = await Api.GetPromptsAsync() ?? new();
    }

    private async Task DeletePrompt(Models.PromptDto p)
    {
        if (p.IsSystem) return;
        await Api.DeletePromptAsync(p.Id);
        if (selectedPrompt?.Id == p.Id) selectedPrompt = null;
        prompts = await Api.GetPromptsAsync() ?? new();
    }
}

<style>
    .sub { color: #666; margin-bottom: 1rem; }
    .prompt-layout { display: grid; grid-template-columns: 300px 1fr; gap: 1rem; }
    .prompt-list, .prompt-editor { background: #fff; border-radius: 10px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .prompt-list h4 { margin-top: 0; }
    .prompt-item { padding: 0.5rem; border-radius: 4px; cursor: pointer; margin-bottom: 0.25rem; border: 1px solid transparent; }
    .prompt-item:hover { background: #f5f5f5; }
    .prompt-item.selected { border-color: #1a1a2e; background: #f0f0ff; }
    .prompt-item strong { display: block; font-size: 0.85rem; }
    .cat { font-size: 0.75rem; color: #888; }
    .badge { font-size: 0.65rem; background: #e0e0ff; padding: 1px 6px; border-radius: 10px; margin-left: 4px; }
    .name-input, .cat-input { width: 100%; padding: 0.4rem; border: 1px solid #ddd; border-radius: 6px; margin-bottom: 0.5rem; box-sizing: border-box; }
    .content-area { width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 6px; font-family: monospace; font-size: 0.8rem; box-sizing: border-box; }
    .editor-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
    .btn { padding: 0.4rem 0.75rem; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.8rem; }
    .btn-primary { background: #1a1a2e; color: #fff; }
    .btn-secondary { background: #e0e0e0; color: #333; }
    .btn-sm { font-size: 0.75rem; }
    .placeholder { color: #999; font-style: italic; }
</style>
